---
const {url, title, footer} = Astro.props;
---
<article class="card"><h2><a href={url}>{title}</a></h2><div><slot /></div><footer>{footer}</footer></article>
<style>.card{border:1px solid #aaa;border-radius:6px;padding:1.25rem;height:100%}.card h2{font-size:1.2rem}.card footer{margin-top:1rem;font-size:.875rem;opacity:.8}</style>
